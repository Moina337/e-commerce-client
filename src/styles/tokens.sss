:root {
  /* Couleurs */
  --color-primary: #1c1c1e;
  --color-accent: #a0612b;
  --color-accent-hover: #864f22;
  --color-bg: #f5f1ea;
  --color-surface: #ffffff;
  --color-text: #1c1c1e;
  --color-text-muted: #6b6b6b;
  --color-border: #ddd6ca;

  /* Typographie */
  --font-heading: 'Playfair Display', Georgia, serif;
  --font-body: 'Inter', system-ui, sans-serif;

  /* Forme */
  --radius: 4px;
  --shadow-card: 0 2px 12px rgb(0 0 0 / 8%);

  /* Espacements */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 16px;
  --space-4: 24px;
  --space-5: 40px;
  --space-6: 64px;
}